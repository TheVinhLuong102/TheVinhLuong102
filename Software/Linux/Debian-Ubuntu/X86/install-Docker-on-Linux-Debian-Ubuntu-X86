#!/usr/bin/env bash

# Official source:
# https://docs.docker.com/engine/install/ubuntu/

set -euo pipefail

echo "==> Remove old/unofficial Docker packages if present"
for package_name in docker.io docker-doc docker-compose docker-compose-v2 podman-docker containerd runc; do
  sudo apt-get remove -y "${package_name}" || true
done

echo "==> Install prerequisites"
sudo apt-get update
sudo apt-get install -y ca-certificates curl

echo "==> Add Docker's official GPG key"
sudo install -m 0755 -d /etc/apt/keyrings
sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
sudo chmod a+r /etc/apt/keyrings/docker.asc

echo "==> Add Docker apt repository"
echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu \
  $(. /etc/os-release && echo "${VERSION_CODENAME}") stable" | \
  sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

echo "==> Install Docker Engine and plugins"
sudo apt-get update
sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

echo "==> Verify Docker daemon and client"
sudo docker run hello-world
docker --version
docker compose version

echo
echo "Docker installation complete."
echo "Optional (run Docker without sudo):"
echo "  sudo usermod -aG docker \$USER"
echo "  newgrp docker"
echo "Then verify:"
echo "  docker run hello-world"
